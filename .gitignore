**/node_modules/
**/dist/
**/.next/
**/.vinext/
site/standalone-dist/
**/.wrangler/
**/.dev.vars
site/.openai/

# Secrets, caches, and local noise.
.env*
*.pem
*.key
*.log
*.tsbuildinfo
.DS_Store
coverage/
*.tar.gz
