# Private/copyrighted source snapshots and provenance are audit inputs, never repository payloads.
.private/
data/transcripts/

# Local decision-system state and output are always private. These explicit
# patterns are defense in depth under the already ignored .private/ tree.
.private/decision-system/
.private/current/
.private/forecast-scenarios/

