{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://longo1231.github.io/nfl-2026-outlook/schemas/market-quote.schema.json",
  "title": "Normalized market quote",
  "type": "object",
  "required": ["quote_id", "snapshot_id", "venue_id", "series_ticker", "contract_id", "team_id", "market_type", "threshold", "side", "bid", "ask", "bid_size", "ask_size", "spread", "captured_at", "recorded_at", "source_time_confidence", "fee_schedule_id", "stale_after", "status", "executable_asks", "execution_scenarios", "movement"],
  "properties": {
    "quote_id": {"type": "string"},
    "snapshot_id": {"type": "string"},
    "venue_id": {"type": "string"},
    "series_ticker": {"type": "string"},
    "contract_id": {"type": "string"},
    "team_id": {"type": "string"},
    "market_type": {"type": "string"},
    "threshold": {"type": ["number", "null"]},
    "side": {"type": "string"},
    "bid": {"type": ["number", "null"]},
    "ask": {"type": ["number", "null"]},
    "bid_size": {"type": ["number", "null"]},
    "ask_size": {"type": ["number", "null"]},
    "spread": {"type": ["number", "null"]},
    "source_quote_at": {"type": ["string", "null"], "format": "date-time"},
    "captured_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "source_time_confidence": {"enum": ["source-time", "capture-time-only"]},
    "fee_schedule_id": {"type": ["string", "null"]},
    "stale_after": {"type": "string", "format": "date-time"},
    "status": {"enum": ["active", "review_due", "stale", "superseded", "retracted", "ambiguous"]},
    "executable_asks": {"type": "array", "items": {"type": "object"}},
    "execution_scenarios": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "movement": {"type": "object"}
  },
  "additionalProperties": true
}
